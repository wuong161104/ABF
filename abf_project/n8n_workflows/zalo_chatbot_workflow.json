      "parameters": {
        "jsCode": "const output = $input.first().json.output || '';\n// Chia nhỏ tin nhắn dựa trên hai ký tự xuống dòng liên tiếp\nconst paragraphs = output.split(/\\n\\n+/).map(p => p.trim()).filter(p => p.length > 0);\n\nconst items = [];\nlet accumulatedDelay = 0;\n\nfor (let i = 0; i < paragraphs.length; i++) {\n  let delay = 0;\n  if (i > 0) {\n    // Thời gian trễ ngẫu nhiên từ 5s đến 12s cho các tin nhắn sau tin nhắn đầu tiên\n    const randomSec = Math.floor(Math.random() * 8) + 5;\n    accumulatedDelay += randomSec;\n    delay = accumulatedDelay;\n  }\n  items.push({\n    json: {\n      message: paragraphs[i],\n      delay: delay,\n      index: i,\n      total: paragraphs.length\n    }\n  });\n}\n\nreturn items;"
      },
